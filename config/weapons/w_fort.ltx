[wpn_fort]:identity_immunities
GroupControlSection		= spawn_group
discovery_dependency		= 
$spawn 				= "weapons\fort"	; option for Level Editor
$npc				= on		; option for Level Editor
$prefetch 			= 8             
scheduled 	 		= off 		; option for ALife Simulator
cform 	 			= skeleton
class 	 			= WP_USP45
min_radius 		 	= 1
max_radius 			= 10
description			= enc_weapons1_wpn-fort

ef_main_weapon_type		= 0
ef_weapon_type			= 5

;-----------------------------------------------------------------------------------
holder_range_modifier		= 1.0 		; во сколько раз увеличивается eye_range 
holder_fov_modifier		= 1.5 		; во сколько раз увеличивается eye_fov
;-----------------------------------------------------------------------------------

cost				= 350
 
ammo_limit			= 120
ammo_current			= 120
ammo_elapsed			= 14
ammo_mag_size			= 1

fire_modes				=  1

ammo_class			= clip_12_9x18_fmj, clip_12_9x18_pmm
tracers				= off
	
hand_dependence			= 1
single_handed			= 1

slot 				= 1
animation_slot			= 1		; type of the animation that will be used

inv_name			= wpn-fort
inv_name_short			= wpn-fort
inv_weight			= 0.92
	
inv_grid_width				= 1
inv_grid_height				= 1
inv_grid_x					= 39
inv_grid_y					= 27


;спавнить автоматически боеприпасы при подъеме оружия
auto_spawn_ammo			= false

;-----------------------------------------------------------------------------------
;базовая дисперсия
dispersion_start		= 0
fire_dispersion_base		= 0.21 		;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)

;отдача
cam_relax_speed 		= 9.05		;скорость возврата в исходное положение
cam_dispersion 			= 0.15		;увеличения угла (в градусах) с каждым выстрелом
cam_dispersion_inc		= 0.0		;увеличениe cam_dispersion с каждым выстрелом
cam_dispertion_frac		= 1.0		;ствол будет подыматься на cam_dispersion*cam_dispertion_frac +- cam_dispersion*(1-cam_dispertion_frac)
cam_max_angle			= 8.0		;максимальный угол отдачи
cam_max_angle_horz		= 5.0		;(degree) maximum shot horizontal degree 
cam_step_angle_horz		= 0.5		;(degree) size of step camera moved in horizontal position while shooting

fire_dispersion_condition_factor= 5		;увеличение дисперсии в процентах при максимальном износе 
misfire_probability 		= 0.00065		;вероятность осечки при максимальном износе
misfire_condition_k		= 0.05 
condition_shot_dec 		= 0.00004 	;увеличение износа при каждом выстреле
;-----------------------------------------------------------------------------------

direction           	    = 0, 0, 1
fire_point               	= 0.0, 0.125, 0.167

flame_particles		   	= weapons\generic_weapon03
smoke_particles			= weapons\generic_shoot_00

shell_point		 	= 0.00, 0.127, 0.053
shell_dir		 	= 0.0, 0.0, 0.4
shell_particles	 		= weapons\generic_shells
 
PDM_disp_base 			= 1.0
PDM_disp_vel_factor 		= 1.4
PDM_disp_accel_factor 		= 1.6
PDM_crouch	 		= 0.8
PDM_crouch_no_acc 		= 0.6

; ttc
hit_power			= 0.5
hit_impulse		 	= 52
hit_type 		 	= fire_wound

fire_distance 			= 55
bullet_speed			= 390 		;начальная скорость пули
rpm 				= 280
rpm_empty_click 		= 150
; end ttc

use_aim_bullet			= true		;Поддерживается ли первая суппер пуля
time_to_aim			= 1.0	

hud 	 			= wpn_fort_hud
normal 	 			= 0, 1, 0
position                 	= -0.026,-0.083, -0.014
orientation              	= 0, 0, 1

;--STRAP PARAMETERS-----------------------------------------------------------------
;strap_position 		= -0.1,-0.45,0.2			; position (offset) and orientation of the weapon when it is strapped
;strap_orientation 		= 1.57,0,0						; (3rd person view)
;strap_bone0			= bip01_spine2
;strap_bone1			= bip01_spine1

visual 				= weapons\fort14\wpn_fort14.ogf

light_disabled			= true

ph_mass			 	= 1

;addons
scope_status			= 0
silencer_status			= 2
grenade_launcher_status		= 0

zoom_enabled			= true
scope_zoom_factor	 	= 55

silencer_name  				= wpn_addon_silencer		; section name for the attachable silencer
silencer_x 					= 40						; offset in inventory icon
silencer_y 					= -14		
;silencer_flame_particles 	= weapons\generic_weapon01
silencer_smoke_particles 	= weapons\generic_shoot_00

silencer_hit_power		= 0.4
silencer_hit_impulse	 	= 52
silencer_fire_distance 		= 50
silencer_bullet_speed	 	= 320

silencer_light_color		= 0.6,0.5,0.3
silencer_light_range		= 0.01
silencer_light_var_color	= 0.05
silencer_light_var_range	= 0.5
silencer_light_time 		= 0.2

;sounds (name of the sound, volume (0.0 - 1.0), delay (sec))
snd_draw					= weapons\fort14\fort_draw, 0.5
snd_holster					= weapons\generic_holster, 0.3
snd_shoot					= weapons\fort14\fort_shoot, 0.3
snd_empty					= weapons\fort14\fort_empty, 0.5
snd_reload					= weapons\fort14\fort_reload, 0.8
snd_close					= weapons\fort14\fort_close, 0.5
snd_silncer_shot			      = weapons\fort14\fort_shot_sil, 0.4

;-----------------------------------------------------------------------------
;-- HUD DESCRIPTION
;-----------------------------------------------------------------------------
[wpn_fort_hud]
allow_inertion			= true

shell_point				= 0,0,-0.4
shell_dir		 		= 0.0, 1.0, 0.0
fire_point				= 0.000000,0.010000,-0.290000
fire_bone                	= muzzle
orientation              	= 3,2,0
position                 	= 0.10,-0.05,0.2

visual                   	= weapons\fort14\wpn_fort14_hud.ogf

anim_holster			= holster
anim_idle				= idle
anim_empty				= empty
anim_reload				= reload_full
anim_reload_empty			= reload
anim_draw				= draw
anim_draw_empty			= draw_empty
anim_shoot				= shoot
anim_shot_last			= shoot_last
anim_close				= idle_aim
anim_idle_aim			= idle_aim
anim_idle_sprint			= idle_sprint

;смещения HUD для режима приближения
zoom_offset				= -0.11148,0.042,0.0
zoom_rotate_x			= 0.014
zoom_rotate_y			= 0.054

;-----------------------------------------------------------------------------
;прячем перекрестие прицела в зуме
zoom_hide_crosshair		= true

;время поворота HUD (сек)
zoom_rotate_time		= 0.2
rotate_time			= 0.2
