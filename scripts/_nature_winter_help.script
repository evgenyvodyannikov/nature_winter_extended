function have_n_m(section,number)
    local actor = db.actor
    if actor then
        local cnt = 0
        actor:iterate_inventory(
            function (dummy, item)
            if item:section() == section then cnt = cnt + 1 end
            end
        ,nil)
        return cnt >= number
    end
    return false
end
