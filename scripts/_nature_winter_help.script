local t_wpn = {"ПРЕДМЕТ1", "ПРЕДМЕТ1", "ПРЕДМЕТ1"}
function search_ALL_weapons_complete()
    local gg = db.actor
    if gg then
        for i=1,#t_wpn  do
            if not gg:object(t_wpn[i]) then 
                return false
            end
        end
        gg:give_info_portion("ПОРШЕНЬ")
        return true 
    end
return false
end
