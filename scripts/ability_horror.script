function start()
local spw = ui_horror.horror(get_hud())
level.start_stop_menu(spw,true)
end

function timer_st()
timer = 0
end

function godmod()
db.actor:give_info_portion("god_mode")
end

function disable_godmod()
db.actor:disable_info_portion("god_mode")
news_manager.send_tip(db.actor, "%c[255,255,128,128]Rage Mod:\n%c[default]Ѕессмертие отключено.", nil, nil, 30000)
end

function god_update()
if db.actor:has_info("god_mode") then
db.actor.health = 1.0
end
end

function next_vis()
	db.actor:give_info_portion("ah")
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]“елепортаци€ прошла успешно.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    local oItem = db.actor:object("point_horror") 
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end

