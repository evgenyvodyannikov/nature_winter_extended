-- Rage Mod - ‘ункци€ нажати€ на “јЅ
local timer = 0

function main(delta)
   if timer>1000000 then timer = 1000000 end
timer = timer+delta
local hud = get_hud()
   if hud:GetCustomStatic("main_task") and timer>3000 then
this.start()
timer = 0
end
end

function power_teleport()
