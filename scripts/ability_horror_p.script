function new_dialog_sidor()
local v= "point_horror"
           if db.actor:has_info("new_dialog_sidor") then
	this.next_vis_sidor_error()
           end
           if db.actor:object(v) and db.actor:has_info("ch") and db.actor:dont_has_info("new_dialog_sidor") and db.actor:money()>=15000 then
	db.actor:give_info_portion("new_dialog_sidor")
	this.next_vis_sidor()
           end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас недостаточно баллов страха - дл€ открыти€ диалога.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:dont_has_info("ch") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел сH.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<15000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ открыти€ диалога.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function next_vis_sidor()
	db.actor:give_info_portion("dh")
	ability_horror_money.del_money_two()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]ќткрыт новый диалог с —идоровичем.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    local oItem = db.actor:object("point_horror") 
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end

function next_vis_sidor_error()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[220,255,1,1]¬ы уже открыли диалог с —идоровичем.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end


local items={
"af_electra_touster",
"af_radiation_crystall_mod_1",
"af_drops_mod_1",
"af_gravi_mod_2",
"af_tiski_al",
"af_chemical-burn_crystall_mod_1",
"af_medusa_elerium-115_01",
"af_fireball_adegansky_crystall_01_and_adegansky_crystall_01",
"af_tiski_pb",
"af_fuzz_kolobok_mod_3",
"af_dummy_spring_mod_1",
"af_tiski_cu",
"af_fireball_cortosis_01_and_cortosis_01"
}

function create()
local v= "point_horror"
           if db.actor:object(v) and db.actor:has_info("dh") and db.actor:money()>=50000 then
	this.create_item(items[math.random(13)])
	this.next_vis()
           end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас недостаточно баллов страха - дл€ получени€ уникального предмета.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:dont_has_info("dh") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел dH.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<50000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ получени€ уникального предмета.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function create_item(spawn_item, npc)
  if npc==nil then 
    npc=db.actor 
  end
  return alife():create(spawn_item, 
      npc:position(),
      npc:level_vertex_id(),  
      npc:game_vertex_id(),
      npc:id())
end

