local items={
"point_horror",
"point_horror"
}

function buy_horror()
           if db.actor:has_info("ah") and db.actor:money()>=100000 then
	this.create_item(items[math.random(2)])
	this.next_vis()
           end
           if db.actor:dont_has_info("ah") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел aH.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<100000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ покупки балла '—трах'.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function create_item(spawn_item, npc)
  if npc==nil then 
    npc=db.actor 
  end
  return alife():create(spawn_item, 
      npc:position(),
      npc:level_vertex_id(),  
      npc:game_vertex_id(),
      npc:id())
end

function next_vis()
	ability_horror_money.del_money_four()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]ѕриобретен балл '—трах'.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end


function buy_open_new_case()
local v= "point_horror"
           if db.actor:has_info("buy_open_this_case") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы уже открыли квест.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:object(v) and db.actor:has_info("eh") and db.actor:dont_has_info("buy_open_this_case") and db.actor:money()>=100000 then
	this.next_vis_new_case()
           end
           if db.actor:dont_has_info("eh") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел eH.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<100000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ открыти€ квеста.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас недостаточно баллов страха - дл€ открыти€ квеста.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function next_vis_new_case()
	db.actor:give_info_portion("buy_open_this_case")
	ability_horror_money.del_money_four()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]ќткрыт новый квест у Ѕармена.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    local oItem = db.actor:object("point_horror") 
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end