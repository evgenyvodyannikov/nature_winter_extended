function power_teleport()
local dir = db.actor:direction()
local pos = db.actor:position()
local v= "point_murder"
           if db.actor:object(v) and db.actor:has_info("am") then
	pos = pos:add(dir:mul(5))
	db.actor:set_actor_position(pos)
	this.next_vis()
	end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас недостаточно баллов убийства - дл€ телепортации.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
	end
           if db.actor:dont_has_info("am") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел aM.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function next_vis()
	db.actor:give_info_portion("bm")
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]“елепортаци€ прошла успешно.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    local oItem = db.actor:object("point_murder") 
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end



local items={
"point_murder",
"point_murder"
}

function buy_murder()
           if db.actor:has_info("am") and db.actor:money()>=100000 then
	this.create_item(items[math.random(2)])
	this.next_vis_buy()
           end
           if db.actor:dont_has_info("am") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел aM.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<100000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ покупки балла '”бийство'.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function create_item(spawn_item, npc)
  if npc==nil then 
    npc=db.actor 
  end
  return alife():create(spawn_item, 
      npc:position(),
      npc:level_vertex_id(),  
      npc:game_vertex_id(),
      npc:id())
end

function next_vis_buy()
                 ability_horror_money.del_money_four()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]ѕриобретен балл '”бийство'.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end