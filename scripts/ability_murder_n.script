end

function next_vis_sidor_error()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[220,255,1,1]¬ы уже открыли диалог с Ѕарменом.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
