local items={
"wpn_ak74u",
"wpn_ak74",
"wpn_abakan",
"wpn_beretta",
"wpn_colt1911",
"wpn_bm16",
"wpn_toz34",
"wpn_desert_eagle",
"wpn_fort",
"wpn_groza",
"wpn_hpsa",
"wpn_l85",
"wpn_lr300",
"wpn_mp5",
"wpn_pb",
"wpn_vintorez",
"wpn_walther",
"wpn_wincheaster1300",
"wpn_pm",
"medkit",
"medkit_army",
"antirad",
"novice_outfit",
"bandit_outfit",
"stalker_outfit",
"killer_outfit"
}

function create()
local v= "point_murder"
           if db.actor:object(v) and db.actor:has_info("bm") and db.actor:money()>=10000 then
	this.create_item(items[math.random(26)])
	this.next_vis()
           end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас недостаточно баллов убийства - дл€ получени€ предмета.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:dont_has_info("bm") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел bM.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<10000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ получени€ предмета.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function create_item(spawn_item, npc)
  if npc==nil then 
    npc=db.actor 
  end
  return alife():create(spawn_item, 
      npc:position(),
      npc:level_vertex_id(),  
      npc:game_vertex_id(),
      npc:id())
end

function next_vis()
	db.actor:give_info_portion("cm")
                 ability_horror_money.del_money_one()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,1,255,1]ѕредмет получен.%c[default]").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    local oItem = db.actor:object("point_murder") 
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end


function new_dialog_barmen()
local v= "point_murder"
           if db.actor:has_info("new_dialog_barmen") then
	this.next_vis_sidor_error()
           end
           if db.actor:object(v) and db.actor:has_info("cm") and db.actor:dont_has_info("new_dialog_barmen") and db.actor:money()>=15000 then
	db.actor:give_info_portion("new_dialog_barmen")
	this.next_vis_barmen()
           end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас недостаточно баллов убийства - дл€ открыти€ диалога.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:dont_has_info("сm") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]¬ы не активировали раздел сM.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:money()<15000 then 
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_weapons")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("%c[255,255,1,1]” ¬ас не достаточно денег - дл€ открыти€ диалога.%c[default]").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

