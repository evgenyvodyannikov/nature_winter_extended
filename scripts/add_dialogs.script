	local eat_name = {		"conserva",
				"bread",
				"kolbasa",
				"nuts"}

	local str = game.translate_string(news_manager.get_inv_name(section))
	if string.find(section,"detector_") then 
		return game.translate_string("Детектор")
	end
	if string.find(section,"af_") then 
		return game.translate_string("Артефакт")
	end
	if (string.find(section,"medkit") or (section == "antirad") or (section == "bandage")) then 
		return game.translate_string("Медикаменты")
	end
	if string.find(section,"grenade_") then 
		return game.translate_string("Взрывчатка")
	end
	if (string.find(section,"ammo_vog-25") or string.find(section,"ammo_m209")) then 
		return game.translate_string("Подствольные гранаты")
	end
	if string.find(section,"_drink_") then 
		return game.translate_string("Напитки")
	end
	if string.find(section,"ammo_") then 
		return game.translate_string("Патроны")
	end
	if string.find(section,"mutant_") then 
		return game.translate_string("Части мутанта")
	end
	if string.find(section,"wpn_addon_") then 
		return game.translate_string("Модификация для оружия")
	end
	for i=1, table.getn(eat_name), 1 do
		if section == eat_name[i] then 
			return game.translate_string("Еда")
		end
	end
	return str
end

---------hunter quest-------

function check_ready_quest(first_speaker, second_speaker)
--	dbglog ("check_ready_quest(%s,%s)",first_speaker:name(),second_speaker:name())
	if check_quest_time_limit(first_speaker, second_speaker) then 
		return check_no_wounded(first_speaker, second_speaker)
	else
		return false
	end
end

function check_quest_time_limit(first_speaker, second_speaker)
	local current_time = get_current_time_minutes()
	local quest_time_limit = xr_logic.pstor_retrieve(second_speaker, "quest_time_limit", 0)
	if quest_time_limit == nil then
		quest_time_limit = current_time
	end
	return (current_time >= quest_time_limit)
end

function hunter_init_quest_dialog(dlg)
--0
	local phr = dlg:AddPhrase("hunters_quest_dialog_0","0","",-10000)
	local phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction("add_dialogs.set_quest_time_limit")
--1
	phr = dlg:AddPhrase("hunters_quest_dialog_1","1","0",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddDontHasInfo("hunter_quest_info")
	phrase_script:AddAction("add_dialogs.hunter_quest_init")

--создаём ветвление восемь вариантов квеста 11...18
	for i=1, 8, 1 do
		phr = dlg:AddPhrase(game.translate_string("hunters_quest_dialog_1"..tostring(i))..game.translate_string("hunters_quest_dialog_1001"), tostring(10 + i),"1",-10000)
		phrase_script = phr:GetPhraseScript()
		phrase_script:AddPrecondition("add_dialogs.check_quest_number_"..tostring(i))

		phr = dlg:AddPhrase("hunters_quest_dialog_111", tostring(110 + i), tostring(10 + i), -10000)
		phrase_script = phr:GetPhraseScript()
		phrase_script:AddAction("add_dialogs.hunter_set_name")
		phrase_script:AddGiveInfo("hunter_quest_info")
	end
--19
	dlg:AddPhrase("hunters_quest_dialog_19","19","1",-10000)
--2
	phr = dlg:AddPhrase("hunters_quest_dialog_2","2","0",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddHasInfo("hunter_quest_info")
	phrase_script:AddPrecondition("add_dialogs.check_hunter_name")
--21
	phr = dlg:AddPhrase("hunters_quest_dialog_21","21","2",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddPrecondition("add_dialogs.check_quest_item")
	phrase_script:AddAction("add_dialogs.relocate_quest_item")
--211
	phr = dlg:AddPhrase("hunters_quest_dialog_211","211","21",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction("add_dialogs.hunter_quest_reward")
	phrase_script:AddDisableInfo("hunter_quest_info")
--22
	phr = dlg:AddPhrase("hunters_quest_dialog_22","22","2",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction("add_dialogs.delete_timeout")
--23
	phr = dlg:AddPhrase("hunters_quest_dialog_23","23","2",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddAction("add_dialogs.set_quest_time_limit")
--231
	phr = dlg:AddPhrase("hunters_quest_dialog_231","231","23",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddDisableInfo("hunter_quest_info")
	phrase_script:AddAction("add_dialogs.hunter_quest_fail")
	
--ветвление подсказки где находится квестодатель 30..39
	for i=0, 9, 1 do
		phr = dlg:AddPhrase(game.translate_string("hunters_quest_dialog_3").." "..game.translate_string("hunters_quest_dialog_3"..tostring(i)).."...", tostring(30+i),"0",-10000)
		phrase_script = phr:GetPhraseScript()
		phrase_script:AddHasInfo("hunter_quest_info")
		phrase_script:AddPrecondition("add_dialogs.not_check_hunter_name")
		phrase_script:AddPrecondition("add_dialogs.check_quest_level_"..tostring(i))
--390..399
		dlg:AddPhrase("hunters_quest_dialog_391", tostring(390+i), tostring(30+i), -10000)
	end
--4
	phr = dlg:AddPhrase("hunters_quest_dialog_4", "4", "0",-10000)
	phrase_script = phr:GetPhraseScript()
	phrase_script:AddHasInfo("hunter_quest_info")
	phrase_script:AddPrecondition("add_dialogs.not_check_hunter_name")
	phrase_script:AddPrecondition("add_dialogs.check_quest_hunter_dead")
	phrase_script:AddDisableInfo("hunter_quest_info")
	phrase_script:AddAction("add_dialogs.hunter_quest_fail")
--41
	dlg:AddPhrase("hunters_quest_dialog_41", "41", "4", -10000)
end

function check_hunter_quest_live()
	for i=1, se_stalker.get_count_tmp_stalkers(), 1 do
		local obj_id = se_stalker.get_point_tmp_stalkers(i)
		local alife_obj = alife():object(obj_id)
		if (alife_obj ~= nil) and (alife_obj:alive() ~= false) then
			local lname = alife():level_name( game_graph():vertex(alife_obj.m_game_vertex_id ):level_id())
			if alife_obj:name() == quest_hunter_name then
				return lname
			end
		end
	end
	return "dead"
end

function hunter_quest_load(F)
	local quest_time_limit = {{},{}}
	quest_number = F:r_u8()
	quest_hunter_name = F:r_stringZ()
	quest_item_name = F:r_stringZ()
	local count_a = F:r_u16()
	for a=1, count_a, 1 do
		quest_time_limit[1][a] = F:r_stringZ()
		quest_time_limit[2][a] = F:r_u32()
	end 
end

function hunter_quest_save(F)
	F:w_u8(quest_number)
	F:w_stringZ(quest_hunter_name)
	F:w_stringZ(quest_item_name)
	F:w_u16 (0)
end

function hunter_quest_init()
--	math.randomseed(time_global())
	quest_number = math.random(1, 8)
	local task_texture, task_rect = get_texture_info("ui_iconsTotal_monster_part", "ui_iconsTotal_locations")
	db.actor:give_talk_message(game.translate_string(list_quest[quest_number]), task_texture, task_rect, "iconed_trade_info")
	return true
end

function hunter_quest_text(news_text)
	local pda_task = xr_sound.get_safe_sound_object([[device\pda\pda_objective]])
	local task_texture, task_rect = get_texture_info("ui_iconsTotal_monster_part", "ui_iconsTotal_locations")
	pda_task:play(db.actor, 0, sound_object.s2d)
	if db.actor:is_talking() then	
		db.actor:give_talk_message(news_text, task_texture, task_rect,"iconed_answer_item")
	else
		db.actor:give_game_news(news_text, task_texture, task_rect, 0, 3000)
	end	
	local hud = get_hud()
	hud:AddCustomStatic("main_task", true)
	hud:GetCustomStatic("main_task"):wnd():SetTextST(news_text)
	hud:GetCustomStatic("main_task").m_endTime = time_global()/1000 + 5
end

function hunter_quest_fail(speaker1, speaker2)
	hunter_quest_text(game.translate_string("hunter_monster_part_quest_fail").." "..game.translate_string(list_quest[quest_number]))
end

function hunter_quest_reward(speaker1, speaker2) 
	local rang_table = ranks.get_obj_rank_name(speaker1)
	local quest_item = db.actor:object (quest_item_name)
	local min_delta = math.floor(quest_item:cost() - (quest_item:cost()/100)*30)
	local max_delta = math.floor(quest_item:cost() + (quest_item:cost()/100)*10)
	local nn = table.getn(friend_items_table[1])
	local reward_items_table = {{},{}}
	local n_count = 0
	for a=1, nn, 1 do
		if ((friend_items_table[2][a] >= min_delta) and (friend_items_table[2][a] <= max_delta)  and (friend_items_table[1][a] ~= quest_item_name)) or (check_some_item(rang_table, friend_items_table[1][a]) and (friend_items_table[2][a] < quest_item:cost()) and (friend_items_table[2][a]*10 >= quest_item:cost())) then
			n_count = n_count + 1
			reward_items_table[1][n_count] = friend_items_table[1][a]
			reward_items_table[2][n_count] = friend_items_table[2][a]
		end
	end
	if n_count == 0 then 
		reward_flag = false
		return false 
	end
	local rnd_num = math.random(1, table.getn(reward_items_table[1]))
	local item_name = reward_items_table[1][rnd_num]
	local some_items_count = 1
	local cost_some_items = reward_items_table[2][rnd_num]
	if check_some_item(rang_table, item_name) then
		for a=1, 10, 1 do
			if cost_some_items < quest_item:cost() then
				some_items_count = some_items_count +1
				cost_some_items = cost_some_items + reward_items_table[2][rnd_num]
			else 
				break
			end
		end
	end
	local task_texture, task_rect = get_texture_info("ui_iconsTotal_agr_agr_help_krot")
	local dlg_text = ""
	local str_fmt = "%c[255,160,200,160]"
	local tmp_fmt = ""
	local str_fmt_def = "%c[default]"
	if some_items_count > 1 then
		tmp_fmt = " ("..tostring(math.floor(some_items_count)).." "..game.translate_string("st_barter_1")
	end
	dlg_text = " "..game.translate_string(news_manager.get_inv_name(item_name))..str_fmt_def..tmp_fmt
	db.actor:give_talk_message(dlg_text, task_texture, task_rect, "iconed_trade_info")
	for a=1, some_items_count, 1 do
		dialogs.relocate_item_section(db.actor, item_name, "in")
	end
	hunter_quest_text(game.translate_string("hunter_monster_part_quest_end").." "..game.translate_string(list_quest[quest_number]))
	set_quest_time_limit(speaker2, speaker1)
	reward_flag = true
end

function relocate_quest_item(speaker1, speaker2)
	if check_quest_item() then
		dialogs.relocate_item_section(speaker2, quest_item_name, "out")
	end
end

function hunter_set_name(speaker1, speaker2)
--	dbglog ("hunter_set_name(%s,%s)",speaker1:name(),speaker2:name())
	quest_hunter_name = speaker1:name()
	hunter_quest_text(game.translate_string(list_quest[quest_number]))
	delete_timeout(speaker2, speaker1)
end


function delete_timeout(speaker1, speaker2)
--	dbglog ("delete_timeout(%s,%s)",speaker1:name(),speaker2:name())
	local quest_time_limit = get_current_time_minutes()
	xr_logic.pstor_store(speaker2, "quest_time_limit", quest_time_limit)
end


function set_quest_time_limit(speaker1, speaker2)
	local quest_time_limit = get_current_time_minutes() + math.random(120, 600)
	xr_logic.pstor_store(speaker2, "quest_time_limit", quest_time_limit)
--[[
	local quest_time_limit_days = math.floor (quest_time_limit/(24*60))
	local quest_time_limit_hours = math.floor((quest_time_limit - quest_time_limit_days*24*60)/60)
	local quest_time_limit_minutes = (quest_time_limit - quest_time_limit_days*24*60) - quest_time_limit_hours*60
	dbglog("%s_pstor_store(days=%d, hours=%d, minutes=%d)", speaker2:name(),quest_time_limit_days, quest_time_limit_hours, quest_time_limit_minutes)
]]
end

