function get_current_time_minutes()
	local current_minutes = level.get_time_minutes()
	local current_hours = level.get_time_hours()
	local current_days = level.get_time_days()
--	dbglog("get_current_time(days=%d, hours=%d, minutes=%d)", current_days, current_hours, current_minutes)
	return (current_days*24*60 + current_hours*60 + current_minutes)
end

function set_p90_time_limit(speaker1, speaker2)
--   Задаётся в игровых минутах, сутки плюс-минус час
	local p90_time_limit = get_current_time_minutes() + 23*60 + math.random(1, 120)
	xr_logic.pstor_store(speaker1, "p90_time_limit", p90_time_limit)
end

function check_p90_time_limit(speaker1, speaker2)
	local current_time = get_current_time_minutes()
	local p90_time_limit = xr_logic.pstor_retrieve(speaker2, "p90_time_limit", 0)

	return (current_time >= p90_time_limit)
end

