---------All barter-------
function is_friend1(first_speaker, second_speaker)
	return (first_speaker:relation(second_speaker) == game_object.friend)
end

function check_no_wounded(first_speaker, second_speaker)
	return not dialogs.is_opp_wounded(first_speaker, second_speaker)
end

function is_friend2(first_speaker, second_speaker)
	if check_time_limit(second_speaker, first_speaker) then 
		return ((second_speaker:relation(first_speaker) == game_object.friend) and check_no_wounded(first_speaker, second_speaker))
	else
		return false
	end
end

function become_neutral(first_speaker, second_speaker)
	first_speaker:set_relation(game_object.neutral, second_speaker)
end

function check_friend_barter(first_speaker, second_speaker)
	local n = table.getn(actor_items_table)
	local n_count = 0
	local actor_table = {}
	local rang_table = ranks.get_obj_rank_name(first_speaker)
	local min_cost = min_max_cost_table[rang_table][1]
	local max_cost = min_max_cost_table[rang_table][2]

--	dbglog ("rang: %s, min=%d, max=%d ",rang_table,min_cost,max_cost)
	for a=1, n, 1 do
		local actor_items = db.actor:object (actor_items_table[a])
		if actor_items ~= nil then
			local item_cost = actor_items:cost()*actor_items:condition()
			if (item_cost >= min_cost) and (item_cost <= max_cost) then
				n_count = n_count + 1
				actor_table[n_count] = actor_items_table[a]
			end
		end
	end

	if n_count == 0 then 
		barter_flag = false
		return barter_flag
	end

	random_actor_item_name = actor_table[math.random(1, table.getn(actor_table))]
	local random_actor_item = db.actor:object (random_actor_item_name)

	local min_delta = math.floor(random_actor_item:cost() - (random_actor_item:cost()/100)*min_max_delta_table[rang_table])
	local max_delta = math.floor(random_actor_item:cost() + (random_actor_item:cost()/100)*(min_max_delta_table[rang_table]/2))

	local nn = table.getn(friend_items_table[1])
	local barter_items_table = {{},{}}
	n_count = 0
	for a=1, nn, 1 do
		if ((friend_items_table[2][a] >= min_delta) and (friend_items_table[2][a] <= max_delta)  and (friend_items_table[1][a] ~= random_actor_item_name)) or (check_some_item(rang_table, friend_items_table[1][a]) and (friend_items_table[2][a] < random_actor_item:cost()) and (friend_items_table[2][a]*10 >= random_actor_item:cost())) then
			n_count = n_count + 1
			barter_items_table[1][n_count] = friend_items_table[1][a]
			barter_items_table[2][n_count] = friend_items_table[2][a]
		end
	end
	if n_count == 0 then 
		barter_flag = false
		return barter_flag
	end

--- проверить одинаковость меняемых предметов
	local rnd_num = math.random(1, table.getn(barter_items_table[1]))
	random_friend_item_name = barter_items_table[1][rnd_num]
	some_items_count = 1
	local cost_some_items = barter_items_table[2][rnd_num]
	if check_some_item(rang_table, random_friend_item_name) then
	for a=1, 10, 1 do
			if cost_some_items < random_actor_item:cost() then
				some_items_count = some_items_count +1
				cost_some_items = cost_some_items + barter_items_table[2][rnd_num]
			else 
				break
			end
		end
	end
--	dbglog("random friend item: %s, cost:%d count:%d",random_friend_item_name,cost_some_items,some_items_count)

	local task_texture, task_rect = get_texture_info("ui_iconsTotal_lost_thing")
	local dlg_text = ""
	local str_fmt = "%c[255,160,200,160]"
	local tmp_fmt = ""
	local str_fmt_def = "%c[default]"

	if some_items_count > 1 then
		tmp_fmt = " ("..tostring(math.floor(some_items_count)).." "..game.translate_string("st_barter_1")
	end

	dlg_text = game.translate_string("st_barter_2").." "..str_fmt..game.translate_string(news_manager.get_inv_name(random_actor_item_name))
	db.actor:give_talk_message(dlg_text, task_texture, task_rect, "iconed_trade_info")
	task_texture, task_rect = get_texture_info("ui_iconsTotal_found_thing")
	dlg_text = game.translate_string("st_barter_3").." "..str_fmt..game.translate_string(news_manager.get_inv_name(random_friend_item_name))..str_fmt_def..tmp_fmt
	db.actor:give_talk_message(dlg_text, task_texture, task_rect, "iconed_trade_info")

	barter_flag = true 

	local barter_time_limit = get_current_time_minutes() + math.random(120, 600)
	xr_logic.pstor_store(first_speaker, "barter_time_limit", barter_time_limit)
	return true
end

function check_name_current_level(section_name)
	local st_obj_id = 0
	for i=1, se_stalker.get_count_tmp_stalkers(), 1 do
		st_obj_id = se_stalker.get_point_tmp_stalkers(i)
		local st_obj = alife():object(st_obj_id)
		if st_obj ~= nil then
			if string.find(st_obj:name(),section_name) then
				return (level.object_by_id(st_obj.id) ~= nil)
			end
		end
	end
	return false
end

function barter_load(F)
-- Остатки старой системы для совместимости версий
	local barter_time_limit = {{},{}}
	local count_a = F:r_u16()
	for a=1, count_a, 1 do
		barter_time_limit[1][a] = F:r_stringZ()
		barter_time_limit[2][a] = F:r_u32()
	end 
end

function barter_save(F)
-- Для совместимости версий.
	F:w_u16 (0)
end

function check_time_limit(first_speaker, second_speaker)
	local rand_barter = 10
--	dbglog ("check_time_limit()")
	local current_time = get_current_time_minutes()
	local barter_time_limit = xr_logic.pstor_retrieve(first_speaker, "barter_time_limit", 0)
	if barter_time_limit == nil then
		barter_time_limit = current_time
	end
-- Если обмен возможен, с вероятностью rand_barter увеличим таймаут.
	local check_flag = (current_time >= barter_time_limit)
	if check_flag and (math.random(1, 100) < rand_barter) then
		local barter_time_limit = get_current_time_minutes() + math.random(50, 100)
		xr_logic.pstor_store(first_speaker, "barter_time_limit", barter_time_limit)
		check_flag = false
	end
	return check_flag
end

function barter_items()
	local barter_item = db.actor:object (random_actor_item_name)
	if barter_item then
		news_manager.relocate_item(db.actor, "out", random_actor_item_name)
		db.actor:mark_item_dropped(barter_item)  
		alife():release(alife():object(barter_item:id()),true)
		for a=1, some_items_count, 1 do
			dialogs.relocate_item_section(db.actor, random_friend_item_name, "in")
		end
	end
end

function check_barter_flag()
	return barter_flag
end

function check_not_barter_flag()
	return not barter_flag
end

function check_item_for_barter()
	local item_for_barter = db.actor:object (random_actor_item_name)
	return (item_for_barter ~= nil)
end

function check_not_item_for_barter()
	return not check_item_for_barter()
end

function check_some_item(arg_rank, arg_item)
	local n = table.getn(some_items_table[arg_rank])
	for a=1, n, 1 do
		if some_items_table[arg_rank][a] == arg_item then
			return true
		end
	end
	return false
end

local tmp_barter_flag = true

function check_barter_items(first_speaker, second_speaker)
	local n = table.getn(actor_items_table)
	local n_count = 0
	local rang_table = ranks.get_obj_rank_name(first_speaker)
	local min_cost = min_max_cost_table[rang_table][1]
	local max_cost = min_max_cost_table[rang_table][2]
	for a=1, n, 1 do
	local actor_items = db.actor:object (actor_items_table[a])
	if actor_items ~= nil
		then
		local item_cost = actor_items:cost()*actor_items:condition()
		if (item_cost >= min_cost) and (item_cost <= max_cost)
			then
			n_count = n_count + 1
			end
		end
	end
	local count_items = n_count*10
	if count_items > 90 then count_items = 90 end
	if (math.random(1, 100) > count_items) then
		local barter_time_limit = get_current_time_minutes() + math.random(120, 600)
		xr_logic.pstor_store(first_speaker, "barter_time_limit", barter_time_limit)
		tmp_barter_flag = false
		return tmp_barter_flag
	end
	tmp_barter_flag = true
	return tmp_barter_flag
end

function check_not_barter_items(first_speaker, second_speaker)
	return not tmp_barter_flag
end