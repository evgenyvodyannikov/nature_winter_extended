	if (false==app_ready()) or (device().precache_frame>1) then return end
	--'news_manager.send_task(db.actor, "new")
end
----------------------------------------------------------------------------------------------------------------------
local update_cnt = 0
----------------------------------------------------------------------------------------------------------------------
function actor_binder:update(delta)
	object_binder.update(self, delta)
	guiders.start_guid_update()
	
	-- рация для ГГ
	if update_cnt <= 50 then
		update_cnt = update_cnt + 1
	end
	--if update_cnt == 50 then
	--if not db.actor:object("hand_radio_f") then
	--xr_companion.spawn_item_in_inv("hand_radio_f")
	--end	
	--end
	-- рация для ГГ	

	if not self.updated then
		if inv.init_dark_matter() then
			self.updated = true
		end
	end
	-- DEBUG slowdown
--	slowdown.update()

	local time = time_global()
	
	game_stats.update (delta, self.object)

	ammo_manager.update()

	kirag_take_drop.on_update()

	kirag_take_drop.autopickup_update()

	if not inv.inv_mass then
		inv.update_mass()
	end
	-- апдейт погоды
	self.weather_manager:update()
	vvv.show_time()
	-- апдейт схемы детектора
	self.actor_detector:update()

	-- апдейт звуковой схемы актера
	xr_sound.update_actor()

	prot_dyn_news.time_update_dyn_news()
	
	-- апдейт наших функций использования пульта и ремнабора
	 repair.use_repkit()
	 bomba_test.use_pult()
    	 bomba_test.bada_boom()
	
	-- Rage от Вуки на основе работы РУси
	if ability_horror then ability_horror.main(delta) end

	ability_horror.god_update()
	timer_god.time_update_god()
	timer_god.time_second_update_god()
	--' Проверка потери жизни
--[[
	if self.object.health - lasthealth > 0.001 or
	   self.object.health - lasthealth < -0.001 then
		printf("%f | %f", self.object.health, self.object.health - lasthealth, game.time() - lasttime)
		lasthealth = self.object.health
		lasttime = game.time()
	end
]]	
	-- Обновление отключения ввода с клавиатуры.
	if self.st.disable_input_time ~= nil and
	   game.get_game_time():diffSec(self.st.disable_input_time) >= self.st.disable_input_idle 
	then
		level.enable_input()
		self.st.disable_input_time = nil
	end

	-->>Treasure rucksack 1/2
	if self.rr_id~=nil then
		-- пытаемся получить объект по id
		local se_obj=alife():object(self.rr_id)
		-- проверяем, что объекта нет
		if se_obj==nil or se_obj:section_name()~="inv_ruck" then
			local ruck=alife():create("active_ruck", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id())
			level.map_add_object_spot_ser(ruck.id, "red_location", "%c[255,238,155,23]Мой тайник")
			news_manager.send_tip(db.actor, "Тайник заложен.", nil, nil, 5000)
		end
		-- сбросим переменную
		self.rr_id=nil
	end
	--<<

	-- Обновление сна с переносом чувака в указанную позицию
	if self.st.sleep_relocate_time ~= nil and
	   game.get_game_time():diffSec(self.st.sleep_relocate_time) >= self.st.sleep_relocate_idle 
	then
		self.object:set_actor_position(self.st.sleep_relocate_point)
		local dir = self.st.sleep_relocate_point:sub(self.st.sleep_relocate_look)
		self.object:set_actor_direction(dir:getH())
		self.st.sleep_relocate_time = nil
	end

	-- Апдейт прятание оружия игрока во время диалога
	if weapon_hide == true or self.object:is_talking() then
		if self.weapon_hide == false then
			self.object:hide_weapon()
			self.weapon_hide = true
		end
	else
		if self.weapon_hide == true then
			self.object:restore_weapon()
			self.weapon_hide = false
		end
	end
	buffer_item.update()
        sigerous_scripts.sigerous_mod_init()
	cnt_zomb.StaticUpdate()
--if tabula_rasa then tabula_rasa.update(delta) end
	d2hud.update()
	temperature.getwind(delta)
	case_9_method_of_teleportation_next.timer_ten_seconds()
	case_9_method_of_teleportation_next.hud_static()
	case_10_mutation.timer_ten_seconds()
	case_10_mutation.hud_static()
	case_10_mutation_next.timer_survive_seconds()
	case_10_mutation_next.hud_static()
	case_11_old_friend.timer_five_seconds()
	story_colt1912_memory.timer_ten_sec() 
	story_girl_memory.timer_ten_sec() 

	if spawn_monsters_01.load_variable("spawn_skelet_strong",false)==false then
		spawn_monsters_01.start_add_spawn()
		spawn_monsters_01.save_variable("spawn_skelet_strong",true)
			end

	if spawn_monsters_02.load_variable("spawn_m_fracture_e",false)==false then
		spawn_monsters_02.start_add_spawn()
		spawn_monsters_02.save_variable("spawn_m_fracture_e",true)
			end

	if spawn_items_01.load_variable("spawn_wpn_ak47_camo3",false)==false then
		spawn_items_01.start_add_spawn()
		spawn_items_01.save_variable("spawn_wpn_ak47_camo3",true)
			end

	if spawn_items_02.load_variable("spawn_af_7",false)==false then
		spawn_items_02.start_add_spawn()
		spawn_items_02.save_variable("spawn_af_7",true)
			end

	if trader_add.load_variable("spawn_trader",false)==false then
		trader_add.start_add_spawn()
		trader_add.save_variable("spawn_trader",true)
			end

	if killer_add.load_variable("spawn_killer",false)==false then
		killer_add.start_add_spawn()
		killer_add.save_variable("spawn_killer",true)
			end

	if crysis1_add.load_variable("spawn_crysis1",false)==false then
		crysis1_add.start_add_spawn()
