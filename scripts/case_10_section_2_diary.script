function art_item_spawn()
    local obj= alife():create("m_taynik",vector():set(-14.424,-4.787,-265.384),156775,853)
this.set_metka_one()
end

function set_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="af_drops_gorgona" then
    level.map_add_object_spot_ser(obj.id,"green_location","Излучение")
    return
   end
  end
 end
end

function remove_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="af_drops_gorgona" then
    level.map_remove_object_spot(obj.id,"green_location")
    break
   end
  end
 end
end

