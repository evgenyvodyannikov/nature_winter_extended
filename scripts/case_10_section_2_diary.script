function search_diary_complete(actor, npc)
    if db.actor ~= nil then
        if db.actor:object("case_10_section_2_diary_true") then
            db.actor:give_info_portion("player_take_section_2_diary")
            return true
        end
    end
return false
end

function search_art_complete(actor, npc)
    if db.actor ~= nil then
        if db.actor:object("af_drops_gorgona") then
            db.actor:give_info_portion("player_find_art_bar_dmitry")
            return true
        end
    end
return false
end


function start_add_spawn_docs()
spawn_false_one()
spawn_false_two()
spawn_false_three()
spawn_false_four()
spawn_false_five()
spawn_true()
spawn_npc()
end

