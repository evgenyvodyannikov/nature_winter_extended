function actor_have_art_case(actor, npc)
      return actor:object("af_drops_gorgona") ~= nil
end

function actor_give_art_and_have_case(actor, npc)
dialogs.relocate_item_section(actor, "ammo_11.43x23silv", "in")
dialogs.relocate_money(db.actor,math.random(10000,15000),"in")
this.delete_af_drops_gorgona_from_actor()
end

function delete_af_drops_gorgona_from_actor()
    local oItem = db.actor:object("af_drops_gorgona")
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end

function actor_give_gun_supnat(actor, npc)
dialogs.relocate_item_section(actor, "wpn_supernatural_colt", "in")
dialogs.relocate_item_section(actor, "ammo_11.43x23silv", "in")
end


