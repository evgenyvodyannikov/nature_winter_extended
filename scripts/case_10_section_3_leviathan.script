function art_item_spawn()
    local obj= alife():create("l_taynik",vector():set(-140.778,0.977,-522.677),18315,832)
this.set_metka_one()
end

function set_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="af_drops_gorgona_l" then
    level.map_add_object_spot_ser(obj.id,"green_location","Точка назначения")
    return
   end
  end
 end
end

function remove_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="af_drops_gorgona_l" then
    level.map_remove_object_spot(obj.id,"green_location")
    break
   end
  end
 end
end

function actor_want_gun(actor, npc)
dialogs.relocate_item_section(actor, "ammo_11.43x23silv", "in")
dialogs.relocate_item_section(actor, "ammo_11.43x23silv", "in")
end

function actor_back_souls()
    local cnt = db.actor:object_count()
    local ch=0
    for i=0, cnt-1 do
        local item = db.actor:object(i)
        if item:section() == "soul_zombie_n" then
            local sobj = alife():object(item:id())
            if sobj then 
                alife():release(sobj,true)
                ch = ch+1
                if ch == 5 then 
                break end 
            end 
        end
    end 
end