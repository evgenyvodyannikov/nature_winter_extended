function text3_eleven_case(first_speaker, second_speaker)
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_agroprom_get_military_documents")
               local error_text = "%c[255,160,160,160]"..game.translate_string("Сообщение от Падалеки:").."\\n".."%c[default]"..""..game.translate_string("%c[255,255,1,1]Подойди ко мне%c[default]")..""
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 60000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_murder]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end