function elk_death()
local obj= alife():create("npc_1871",vector():set(19.800,-10.828,-3.473),5775,1137)
obj:on_death()
end

function search_case_12_complete(actor, npc)
    if db.actor ~= nil then
        if db.actor:object("case_12_blood_dream_begin") then
            db.actor:give_info_portion("player_complete_case_12_blood_dream_part_1")
            db.actor:give_info_portion("player_have_case_12_blood_dream_begin")
            return true
        end
    end
return false
end

function last_all_or() 
again_animation()
del_npc_one()
zombie_create()
zombie_create_two()
zombie_create_three()
zombie_create_four()
zombie_create_five()
case_13_quantum_leap.start_spawn_nw()
end

function del_npc_one()
    local se_obj = alife():object("npc_1875")
    if se_obj then
        alife():release(se_obj, true)
    end
end

function again_animation()
    local snd_obj = xr_sound.get_safe_sound_object([[affects\hit_fist]])
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    level.add_cam_effector("camera_effects\\empty.anm", 999, false, "") 
    level.add_pp_effector("peace_fade.ppe", 999, false, "") 
end

