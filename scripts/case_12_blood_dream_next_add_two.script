function search_case_12_complete(actor, npc)
    if db.actor ~= nil then
        if db.actor:object("case_12_blood_dream_elephant") then
            db.actor:give_info_portion("player_complete_case_12_blood_dream_part_4")
            return true
        end
    end
return false
end

function get_case_12_cache_last()
get_case_12_cache_last_next()
spawn_military_one()
spawn_military_two()
spawn_military_three()
spawn_military_four()
end

function get_case_12_cache_last_next()
    local obj= alife():create("ctwl_taynik",vector():set(29.4169998168945,-5.01800012588501,-14.3500003814697),6817,1140)
this.set_metka_one()
end

function set_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="unknown_blood_dream" then
    level.map_add_object_spot_ser(obj.id,"green_location","’м, что здесь лежит?")
    return
   end
  end
 end
end

function remove_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="unknown_blood_dream" then
    level.map_remove_object_spot(obj.id,"green_location")
    break
   end
  end
 end
end

