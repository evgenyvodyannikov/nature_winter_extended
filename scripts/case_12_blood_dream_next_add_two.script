function get_case_12_cache()
get_case_12_cache_next()
fracture1_create()
spawn_zombie2_one()
spawn_zombie2_one_next()
end

function get_case_12_cache_next()
treasure_manager.get_treasure_manager():give_treasure("treasure_1870")
end

