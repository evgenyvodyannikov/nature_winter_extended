function case_2_racket_horror_give_dolg_and_wpn(actor, npc)
dialogs.relocate_money(actor, 10000, "in")
dialogs.relocate_item_section(actor, "wpn_pb_modifier_bv", "in")
end

function case_2_racket_horror_give_all_and_wpn(actor, npc)
dialogs.relocate_money(db.actor,math.random(10000,25000),"in")
end

function case_2_racket_give_money_and_pda(actor, npc)
dialogs.relocate_money(npc, 50000, "out")
dialogs.relocate_item_section(npc, "dolg_pda_case_2_racket", "out")
end

function case_2_racket_give_money_and_wpn(actor, npc)
dialogs.relocate_money(actor, 10000, "in")
dialogs.relocate_item_section(actor, "wpn_colt1911", "in")
end

function case_2_racket_money_dolg(actor, npc)
	return actor:money() >= 50000
end

