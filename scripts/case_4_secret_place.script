function case_4_secret_place_give_bullion_gild_quest(actor, npc)
dialogs.relocate_money(actor, 10000, "in")
dialogs.relocate_item_section(npc, "bullion_gild_quest", "out")
dialogs.relocate_item_section(actor, "ogg_flash_3", "in")
end

function case_4_secret_place_give_bullion_gild_quest_and_af_part_monolit_quest(actor, npc)
dialogs.relocate_money(actor, 35000, "in")
dialogs.relocate_item_section(npc, "bullion_gild_quest", "out")
dialogs.relocate_item_section(npc, "af_part_monolit_quest", "out")
dialogs.relocate_item_section(actor, "ogg_flash_3", "in")
end

function actor_have_bullion_gild_quest(actor, npc)
      return actor:object("bullion_gild_quest") ~= nil
end

function actor_have_af_part_monolit_quest(actor, npc)
      return actor:object("af_part_monolit_quest") ~= nil
end

function get_case_4_secret_place()
 local obj = alife():create("cf_taynik",vector():set(194.664001464844,0.0939999967813492,82.5390014648438),45472,1186)
this.set_metka_one()
end


function set_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="bullion_gild_quest" then
    level.map_add_object_spot_ser(obj.id,"green_location","Тайник Прапора")
    return
   end
  end
 end
end

function remove_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="bullion_gild_quest" then
    level.map_remove_object_spot(obj.id,"green_location")
    break
   end
  end
 end
end
