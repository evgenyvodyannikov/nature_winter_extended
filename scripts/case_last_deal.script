function get_case()
    local obj= alife():create("case_t_taynik",vector():set(-169.709,-2.613,-6.868),80840,69)
this.set_metka_one()
end

function set_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="wpn_gaus4" then
    level.map_add_object_spot_ser(obj.id,"green_location","Проверь перед тем, как отправиться на Сделку к Падалеки")
    return
   end
  end
 end
end

function remove_metka_one()
 for a=1,65534 do
  local obj = alife():object(a)
  if obj then
   if obj:section_name()=="wpn_gaus4" then
    level.map_remove_object_spot(obj.id,"green_location")
    break
   end
  end
 end
end


