end

function esc_spawn3_text()
  local se_obj = alife():create("space_restrictor",vector():set(-250.896,-19.601,-127.214),9843,8)
  local custom = "[logic]\n"..
"active = sr_idle\n"..
"[sr_idle]\n"..
"on_actor_inside = %+spawn_pad_deal%"
  rewrite_restrictor(se_obj, custom, 4.0)
end


function text_deal_nw()
text_sid_nw()
text_pad_nw()
text_sid_nw_two()
text_pad_nw_two()
end

function text_sid_nw(first_speaker, second_speaker)
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_esc_trader_job")
               local error_text = "%c[255,160,160,160]"..game.translate_string("Сообщение:").."\\n".."%c[default]"..""..game.translate_string("%c[255,255,1,1]Пад, цель хочет с тобой встретиться, чтобы провести сделку.%c[default]")..""
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 15000)
end

function text_pad_nw(first_speaker, second_speaker)
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_agroprom_get_military_documents")
               local error_text = "%c[255,160,160,160]"..game.translate_string("Сообщение:").."\\n".."%c[default]"..""..game.translate_string("%c[255,255,1,1]Какие условия?%c[default]")..""
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_murder]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end

