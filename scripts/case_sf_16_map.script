function snow_wolf_create()
local x= -383,018
local y= -14,074
local z= 399,565
local level_vertex= 365
local game_vertex_id= 1848
alife():create("white_wolk",vector():set(x,y,z),level_vertex,game_vertex_id)
end

function actor_have_pro(actor, npc)
      return actor:object("ammo_5.45x39pro") ~= nil
end

function case_sf_done(actor, npc)
dialogs.relocate_money(actor, 92000, "in")
this.delete_pro()
ability_horror_all.actor_have_murder()
end

function case_sf_done_yan(actor, npc)
dialogs.relocate_money(actor, 33000, "in")
this.delete_pro()
ability_horror_all.actor_have_murder()
end

function delete_pro()
    local oItem = db.actor:object("ammo_5.45x39pro")
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end