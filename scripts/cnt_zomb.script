function StaticUpdate()
	if InitStatic == true then return true end
	
	local hud, custom_static1, custom_static2 = get_hud(), nil, nil
	
	custom_static1 = hud:GetCustomStatic("info_killed_zombied")
	if custom_static1 == nil then
		hud:AddCustomStatic("info_killed_zombied", true)
		InitStatic = true
		--news_manager.send_tip(db.actor, "загрузка1 "..NumberOfRank, 0, "stalker", 25000)
	end
	custom_static2 = hud:GetCustomStatic("info_killed_zombied_rank")
	if custom_static2 == nil then
		hud:AddCustomStatic("info_killed_zombied_rank", true)
		--news_manager.send_tip(db.actor, "загрузка2 "..NumberOfRank, 0, "stalker", 25000)
	end
	
	custom_static1 = hud:GetCustomStatic("info_killed_zombied")
	custom_static2 = hud:GetCustomStatic("info_killed_zombied_rank")
	if custom_static1 ~= nil then
		custom_static1:wnd():SetTextST(CntKilledZombies)
		dbg("custom_static1>>>SetTextST")
	end
	if custom_static2 ~= nil then
		custom_static2:wnd():SetTextST(TableTxtRank[NumberOfRank])
		dbg("custom_static2>>>SetTextST")
	end
end

function on_death(victim, who)
	if NumberOfRank > #TableTxtRankMsg then return true end
	local hud = get_hud()
	local custom_static, searched = nil, false
	if victim and who then
		if who:id() == db.actor:id() then
			for k, v in pairs(TableSectionsZomb) do
				if v == victim:section() then
					searched = true
				end
			end		
			if searched == true then
				CntKilledZombies = CntKilledZombies + 1
				custom_static = hud:GetCustomStatic("info_killed_zombied")
				if custom_static ~= nil then
					custom_static:wnd():SetTextST(CntKilledZombies)
				end
			end
		end
	end
	if CntKilledZombies >= TableCntZombies[NumberOfRank] then
		NumberOfRank = NumberOfRank + 1
		news_manager.send_tip(db.actor, "Получена «"..TableTxtRankMsg[NumberOfRank - 1].."»", 0, "stalker", 30000)
local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
		alife():create(TableSectionsMedals[NumberOfRank - 1], db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
		custom_static = hud:GetCustomStatic("info_killed_zombied_rank")
		if custom_static ~= nil then
			custom_static:wnd():SetTextST(TableTxtRank[NumberOfRank])
		end
	end
end

function OnUse(obj)
	if obj then
		local IsMedal, ObjSec = nil, obj:section()
		for k, v in pairs(TableSectionsMedals) do
			if v == ObjSec then
				IsMedal = k
			end
		end
		if IsMedal ~= nil then
			db.actor:give_money(TableMoneysInMedals[ObjSec])
			news_manager.send_tip(db.actor, "Использована «"..TableTxtRankMsg[IsMedal].."». Получено денег: "..TableMoneysInMedals[ObjSec], 0, "stalker", 15000)
		end
	end
end







function save_var(p)
	p:w_u32(CntKilledZombies)
	p:w_u32(NumberOfRank)
end

function load_var(r)
	CntKilledZombies = r:r_u32()
	NumberOfRank = r:r_u32()
end
function dbg(DbgInfo)
    get_console():execute("debug:~>"..DbgInfo)
end