function init_derzkiy_actor_dlg_1(dlg)
    phr0 = dlg:AddPhrase(derzkiy_actor_dlg_1_0, "0", "-1", -10000)
	phr1 = dlg:AddPhrase(derzkiy_actor_dlg_1_1, "1", "0", -10000)
	    phr1:GetPhraseScript():AddPrecondition("derzkiy_actor.precond_actor_under_or_ravno")
		phr1:GetPhraseScript():AddAction("derzkiy_actor.rnd_vsech_actoru")
	phr2 = dlg:AddPhrase(derzkiy_actor_dlg_1_2, "2", "0", -10000)
	    phr2:GetPhraseScript():AddPrecondition("derzkiy_actor.precond_actor_older")
	phr3 = dlg:AddPhrase(derzkiy_actor_dlg_1_3, "3", "1", -10000)
	phr4 = dlg:AddPhrase(derzkiy_actor_dlg_1_4, "4", "1", -10000)
	    phr4:GetPhraseScript():AddAction("dialogs.break_dialog")
	phr5 = dlg:AddPhrase(derzkiy_actor_dlg_1_5, "5", "2", -10000)
	    phr5:GetPhraseScript():AddAction("dialogs.break_dialog")
	phr6 = dlg:AddPhrase(derzkiy_actor_dlg_1_6, "6", "3", -10000)
	    phr6:GetPhraseScript():AddAction("derzkiy_actor.rnd_vsech_actoru")
	phr7 = dlg:AddPhrase(derzkiy_actor_dlg_1_7, "7", "6", -10000)
	    phr7:GetPhraseScript():AddAction("dialogs.break_dialog")
	phr8 = dlg:AddPhrase(derzkiy_actor_dlg_1_8, "8", "6", -10000)
	    phr8:GetPhraseScript():AddAction("derzkiy_actor.vsech_po_rozhe_actora")
end

