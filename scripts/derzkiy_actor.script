local timer = 0
local PunchOn = false
local NpcEnemy = false
local NpcEnemyId

------

local ReplayStrike = 0.3 --/30% Вероятность того, что НПС после удара, ударит ГГ еще разок
local StikeNoBazar = 0.1 --/ 10% Вероятность того, что НПС ударит ГГ сразу, после наезда без всяких разговоров

------

function vsech_po_rozhe_actora(actor, npc)
  local cNpc
    if actor ~= nil and npc ~= nil then
        cNpc = level.object_by_id(npc:id())
	end
		if actor == nil and npc == nil then
		    cNpc = NpcEnemyId
		end
        if cNpc == db.actor:id() then
            cNpc = level.object_by_id(actor:id())
        end
        if cNpc then
	        local ComNpc = cNpc:character_community()
            cNpc:clear_animations()
            cNpc:add_animation("udar_0", true, false)
		    npc_punch_to_actor(ComNpc)
		if actor ~= nil and npc ~= nil then
		    actor:stop_talk()
		    npc:stop_talk()
		end
    end
  timer = time_global()
  NpcEnemyId = cNpc
end

function npc_punch_to_actor(com)
    local sound
	sound = sound_object("characters_voice\\human_02\\"..com.."\\talk\\use\\abuse_"..tostring(math.random(1, 4)))
    sound:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
	set_inactivate_input_time(40)
	PunchOn = true
end

function actora_udarili()
    sound = sound_object("actor\\pain_"..tostring(math.random(1, 8)))
    sound:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
	local Rnd = math.random(1, 4)
    sound = sound_object("affects\\hit_fist")
    sound:play_at_pos(db.actor, vector():set(0,0,0), 0, sound_object.s2d)
	level.add_pp_effector("fire_hit.ppe", 1977, false)
	db.actor.health = -0.2
--	db.actor.get_bleeding = -0.5
	if Rnd == 1 then
	    level.add_cam_effector("camera_effects\\empty.anm", 1972, false, "derzkiy_actor.rnd_vsech_actoru_povtorno")
	    level.add_cam_effector("camera_effects\\fusker.anm", 9990, false, "") 
	elseif Rnd == 2 then
	    level.add_cam_effector("camera_effects\\empty.anm", 1972, false, "derzkiy_actor.rnd_vsech_actoru_povtorno")
	    level.add_cam_effector("camera_effects\\dis_consciousness.anm", 9991, false, "") 
	elseif Rnd == 3 then
	    level.add_cam_effector("camera_effects\\empty.anm", 1972, false, "derzkiy_actor.rnd_vsech_actoru_povtorno")
	    level.add_cam_effector("camera_effects\\dream.anm", 9992, false, "") 
	elseif Rnd == 4 then
	    level.add_cam_effector("camera_effects\\empty.anm", 1972, false, "derzkiy_actor.rnd_vsech_actoru_povtorno")
	    level.add_cam_effector("camera_effects\\prison_1.anm", 9993, false, "")
	end
end

function rnd_vsech_actoru_povtorno(actor, npc)
    if math.random() <= ReplayStrike then
	    vsech_po_rozhe_actora(npc, actor)
	end
end

function rnd_vsech_actoru(actor, npc)
    if math.random() <= StikeNoBazar then
	    vsech_po_rozhe_actora(npc, actor)
	end
end

function npc_neytral_to_actor()
    NpcEnemyId:set_relation(game_object.neutral, db.actor)
end

function npc_enemy_to_actor(first_speaker, second_speaker)
    second_speaker:set_relation(game_object.enemy, first_speaker)
	timer = time_global()
	NpcEnemy = true
	NpcEnemyId = level.object_by_id(second_speaker:id())
end

function actor_derzkiy_update()
    if PunchOn == true then
	    if time_global() - timer > 0.9*1000 then
		    actora_udarili()
			PunchOn = false
		end
	end
	if NpcEnemy == true then
	    if time_global() - timer > 7*1000 then
		    npc_neytral_to_actor()
		end
	end
end
	
	
function on_punch_sound_update()
	db.actor:set_fastcall(actor_derzkiy_update, db.actor)
end

--/ГГ старше по рангу
function precond_actor_older(actor, npc)
  local NpcRank = ranks.get_obj_rank_name(actor)
  local ActorRank = ranks.get_obj_rank_name(npc)
  local NpcCntRank = actor:character_rank()
  local ActorCntRank = npc:character_rank()
	if NpcRank ~= ActorRank then
	    if ActorCntRank > NpcCntRank then
		    return true
		else
	        return false
		end
    end
end

--/ГГ младше по рангу
function precond_actor_under_or_ravno(actor, npc)
  local NpcRank = ranks.get_obj_rank_name(actor)
  local ActorRank = ranks.get_obj_rank_name(npc)
  local NpcCntRank = actor:character_rank()
  local ActorCntRank = npc:character_rank()
	if NpcRank == ActorRank or ActorCntRank < NpcCntRank then
		return true
    else
	    return false
    end
end
--[[
local tActorItems = {}
function drop_rnd_items()
  tActorItems = {}
  db.actor:iterate_inventory(function(dummy,Item)
      table.insert(tActorItems,Item:section())
    end
  ,nil)
  drop_rnd_items_()
end

function drop_rnd_items_()
    for i=1, math.random(1, 5) do
      local dItem = tActorItems[math.random(1, table.getn(tActorItems))]
	    if dItem ~= "wpn_knife" and dItem ~= "binocular_a" and dItem ~= "device_pda" and dItem ~= "device_torch" and dItem ~= "detector_simple" 
		and dItem ~= "detector_advances" and dItem ~= "detector_elite" and dItem ~= "bolt" and dItem ~= "detector_advances" and dItem ~= "detector_advances" then
		    local death_ini = ini_file("misc\\death_generic.ltx")
            local n = death_ini:line_count("keep_items")
                for i=0,n-1 do
                  local qItem = death_ini:r_line("keep_items",i,"","")
                        if dItem ~= qItem then
		            db.actor:drop_item(db.actor:object(dItem))
				end
			end
		end
	end
end
]]
function give_500(actor, npc)
	dialogs.relocate_money(actor, 500, "out")
end
