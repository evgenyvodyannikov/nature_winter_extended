function experiments_artifacts_01(actor, npc)
	return actor:money() >= 35000
end

function experiments_artifacts_01_done(actor, npc)
dialogs.relocate_money(npc, 35000, "out")
end

function actor_have_af_medusa_0(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "af_medusa_0", "in")
	dialogs.relocate_item_section(second_speaker, "af_medusa", "out")
end

