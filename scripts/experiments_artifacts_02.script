function actor_have_af_medusa(actor, npc)
      return actor:object("af_medusa") ~= nil
end

function experiments_artifacts_af_medusa(actor, npc)
	return actor:money() >= 2500
end

function actor_return_money(actor, npc)
dialogs.relocate_money(npc, 2500, "out")
end

