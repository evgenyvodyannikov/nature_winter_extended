function create()
local v= "bread"
           if db.actor:object(v) and db.actor:has_info("ah") then
	this.create_item(items[math.random(51)])
	this.next_vis()
	end
           if not db.actor:object(v) then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("” ¬ас недостаточно баллов страха - дл€ получени€ предмета.").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
           if db.actor:object(v) and db.actor:dont_has_info("ah") then
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
               local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("¬ы не активировали раздел aH.").." Х"
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
           end
end

function create_item(spawn_item, npc)
  if npc==nil then 
    npc=db.actor 
  end
  return alife():create(spawn_item, 
      npc:position(),
      npc:level_vertex_id(),  
      npc:game_vertex_id(),
      npc:id())
end

function next_vis()
    local task_texture, task_rect = get_texture_info("ui_iconsTotal_mutant")
    local error_text = "%c[255,160,160,160]"..game.translate_string("—ообщение:").."\\n".."%c[default]".."Х "..game.translate_string("ѕредмет получен.").." Х"
                db.actor:give_game_news(error_text, task_texture, task_rect, 0, 20000)
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_get_item]])
	snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    local oItem = db.actor:object("bread") 
    if oItem then
        alife():release(alife():object(oItem:id()), true)
    end
end