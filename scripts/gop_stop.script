function init_gop_stop_dlg_1(dlg)
    phr0 = dlg:AddPhrase(gop_stop_dlg_1_0, "0", "-1", -10000)
	    phr0:GetPhraseScript():AddAction("gop_stop.joke_precondition4")
    phr1 = dlg:AddPhrase(gop_stop_dlg_1_1, "1", "0", -10000)
	    phr1:GetPhraseScript():AddPrecondition("derzkiy_actor.precond_actor_older")
		phr1:GetPhraseScript():AddPrecondition("gop_stop.not_rnd_phrase3")
    phr2 = dlg:AddPhrase(gop_stop_dlg_1_2, "2", "0", -10000)
	    phr2:GetPhraseScript():AddPrecondition("derzkiy_actor.precond_actor_under_or_ravno")
    phr3 = dlg:AddPhrase(gop_stop_dlg_1_3, "3", "0", -10000)
        phr3:GetPhraseScript():AddAction("gop_stop.Actor_Otrabotal_Money")
	    phr3:GetPhraseScript():AddPrecondition("derzkiy_actor.precond_actor_older")
	    phr3:GetPhraseScript():AddPrecondition("gop_stop.rnd_phrase3")
    phr4 = dlg:AddPhrase(gop_stop_dlg_1_4, "4", "1", -10000)
    phr5 = dlg:AddPhrase(gop_stop_dlg_1_5, "5", "2", -10000)
    phr6 = dlg:AddPhrase(gop_stop_dlg_1_6, "6", "3", -10000)
	    phr6:GetPhraseScript():AddAction("dialogs.break_dialog")
    phr7 = dlg:AddPhrase(gop_stop_dlg_1_7, "7", "4", -10000)
    phr8 = dlg:AddPhrase(gop_stop_dlg_1_8, "8", "5", -10000)
	    phr8:GetPhraseScript():AddPrecondition("derzkiy_actor.precond_actor_under_or_ravno")
	    phr8:GetPhraseScript():AddAction("derzkiy_actor.rnd_vsech_actoru")
    phr9 = dlg:AddPhrase(gop_stop_dlg_1_9, "9", "7", -10000)
    phr10 = dlg:AddPhrase(gop_stop_dlg_1_10, "10", "7", -10000)
	phr10Dublicate = dlg:AddPhrase(gop_stop_dlg_1_10, "10", "1", -10000)
	    phr10:GetPhraseScript():AddAction("dialogs.break_dialog")
    phr11 = dlg:AddPhrase(gop_stop_dlg_1_11, "11", "8", -10000)
	    phr11:GetPhraseScript():AddAction("derzkiy_actor.vsech_po_rozhe_actora")
    phr12 = dlg:AddPhrase(gop_stop_dlg_1_12, "12", "8", -10000)
	phr12Dublicate = dlg:AddPhrase(gop_stop_dlg_1_12, "12", "2", -10000)
	    phr12:GetPhraseScript():AddAction("dialogs.break_dialog")
	phr3Dublicate = dlg:AddPhrase(gop_stop_dlg_1_3, "3", "4", -10000)
end


