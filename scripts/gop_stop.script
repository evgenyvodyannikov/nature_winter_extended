local tUnicItems = 
{
        "wpn_knife",
        "binocular_a",
        "device_pda",
        "device_torch",
        "detector_simple",
        "detector_advances",
        "detector_elite",
        "bolt",
        "hand_radio"
}

local random
local tNpcItems = {}

function Actor_Otrabotal_Money(actor, speaker)
    local NpcC = level.object_by_id(actor:id())
    local NpcMany = GetNpcMoney(NpcC)
	NpcMany = math.random(NpcMany - NpcMany/3.5, NpcMany + NpcMany/3)
    dialogs.relocate_money(actor, NpcMany, "in")
end

function Actor_Otrabotal_Items(actor, speaker)
  local NpcC = level.object_by_id(actor:id())
    tNpcItems = {}
      NpcC:iterate_inventory(function(dummy, Item)
	   local tT = exchanging_items.GetTable_all_items()
	    for k, v in pairs(tT) do
           if Item:section() == v then
                table.insert(tNpcItems, v)
	         end
	      end
      end
   ,nil)
  Actor_Otrabotal_Items_(actor, speaker)
end

function Actor_Otrabotal_Items_(actor, speaker)
  local ItemSection
    if #tNpcItems > 0 then
        for i=1,#tNpcItems do
            ItemSection = tNpcItems[i]
			dialogs.relocate_item_section(actor, ItemSection, "in")
			actor:drop_item(actor:object(ItemSection))
		    local sobj = alife():object(actor:object(ItemSection):id())
                if sobj then 
                    alife():release(sobj,true)
		        end
		   end
	  end
end			
				
function GetNpcMoney(Npc)
    return Npc:money()
end


function joke_precondition4() 
    random = math.random(1, 4) 
end

function rnd_phrase3() 
    if random == r then return false 
        elseif random == 1 then 
            return true 
        else 
       return false 
    end 
end

function not_rnd_phrase3() 
    return not rnd_phrase3()
end


