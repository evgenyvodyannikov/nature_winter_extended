function npc_malo_med(actor, npc)
    if not actor:object("medkit") and not actor:object("medkit_army") and not actor:object("medkit_scientic") then
	    return true
    else
 	     return false
	end
end

function npc_not_malo_med(actor, npc)	
    return not npc_malo_med(actor, npc)
end

function actor_bad_reputation()
    return db.actor:character_reputation() < 0
end

function actor_not_bad_reputation()
    return not actor_bad_reputation()
end

function actor_bleeding()
    return db.actor:get_bleeding() > 0.01
end

function actor_no_medkits()
    if db.actor:object("medkit") or db.actor:object("medkit_army") or db.actor:object("medkit_scientic") then
--	  if db.actor.health >= 0.8 == true then
	    return false
    else
        return true
--	  end
   end
end

function npc_have_medkits(actor, npc)
    if actor:object("medkit") or actor:object("medkit_army") or actor:object("medkit_scientic") then
	    return true
    else
        return false
    end
end

function actor_have_medkit()
    if db.actor:object("medkit") or db.actor:object("medkit_army") or db.actor:object("medkit_scientic") then
	    return true
    else
        return false
    end
end

function npc_dont_have_medkits(actor, npc)
    return not npc_have_medkits(actor, npc)
end

function actor_malo_hp()
    return db.actor.health < 0.5 and actor_no_medkits()
end

function give_medkit_to_actor(actor, npc)
  local Rnd
  Rnd = math.random(1, 2)
  local medkit
  local NpcRank = ranks.get_obj_rank_name(actor)
  
    if NpcRank == "novice" then
        medkit = "medkit"
		
    elseif NpcRank == "experienced" then
	    medkit = "medkit"
	    if Rnd == 2 then
            medkit = "medkit_army"
		end
		
	elseif  NpcRank == "veteran" then
	    medkit = "medkit_army"
		
    elseif NpcRank == "master" then
	    medkit = "medkit_army"
	    if Rnd == 2 then
            medkit = "medkit_scientic"
		end
	 end
   dialogs.relocate_item_section(actor, medkit, "in")
end

function give_medkit_to_npc(actor, npc)
    if db.actor:object("medkit") then
	     dialogs.relocate_item_section(npc, "medkit", "out")
    elseif db.actor:object("medkit_army") then
	     dialogs.relocate_item_section(npc, "medkit_army", "out")
    elseif db.actor:object("medkit_scientic") then
	     dialogs.relocate_item_section(npc, "medkit_scientic", "out")
	end
end

function npc_friend_to_actor(first_speaker, second_speaker)
    second_speaker:set_relation(game_object.friend, first_speaker)
end
