function init_loan_money_out_dlg(dlg)
    phr0 = dlg:AddPhrase(loan_money_out_dlg_0, "0", "-1", -10000)
    phr1 = dlg:AddPhrase(loan_money_out_dlg_1, "1", "0", -10000)
    phr2 = dlg:AddPhrase(loan_money_out_dlg_2, "2", "1", -10000)
	    phr2:GetPhraseScript():AddAction("loan_money.give_money_to_npc")
    phr3 = dlg:AddPhrase(loan_money_out_dlg_3, "3", "1", -10000)
    phr4 = dlg:AddPhrase(loan_money_out_dlg_4, "4", "2", -10000)
end


function save_npc_data(first_speaker, second_speaker)
	tmp = xr_logic.pstor_retrieve(db.actor, "npcloanuserdata", 0)
	tmp = first_speaker:id()
	xr_logic.pstor_store(db.actor, "npcloanuserdata", tmp)
end

