function give_money_to_npc(actor, npc)
    local many = xr_logic.pstor_retrieve(db.actor, "loan_money", 0)
	dialogs.relocate_money(npc, many, "out")
	db.actor:disable_info_portion("have_loan_money")
	db.actor:disable_info_portion("loaner_first_messege")
	db.actor:disable_info_portion("loaner_second_messege")
end

function give_money(actor, npc)
    local loan
	loan = xr_logic.pstor_retrieve(db.actor, "loan_money", 0)
    loan = InMoney
    xr_logic.pstor_store(db.actor, "loan_money", loan) 
	dialogs.relocate_money(actor, InMoney, "in")
	timer = time_global()
	db.actor:give_info_portion("have_loan_money")
end

function have_loan_money()
    if has_alife_info("have_loan_money") then	
	  local loaner = xr_logic.pstor_retrieve(db.actor, "npcloanuserdata", 0)
      local cLoaner = level.object_by_id(loaner)
	    if cLoaner:position():distance_to(db.actor:position()) <= 2 then
	        return true
	    else
	        return false
		end
	end
end

function dont_have_loan_money()
	return not has_alife_info("have_loan_money")
end

function pre_loaner_novice(actor, npc)
  local NpcRank = ranks.get_obj_rank_name(actor)
    if NpcRank == "novice" then
	    return true
	else
	    return false	
    end 
end	

function pre_loaner_experienced(actor, npc)
  local NpcRank = ranks.get_obj_rank_name(actor)
    if NpcRank == "experienced" then
	    return true
	else
	    return false	
    end 
end	

function pre_loaner_veteran(actor, npc)
  local NpcRank = ranks.get_obj_rank_name(actor)
    if NpcRank == "veteran" then
	    return true
	else
	    return false	
    end 
end	

function pre_loaner_master(actor, npc)
  local NpcRank = ranks.get_obj_rank_name(actor)
    if NpcRank == "master" then
	    return true
	else
	    return false	
    end 
end	


function timer_loan()
    if has_alife_info("have_loan_money") then
	    if time_global() - timer > 3600/2*1000 then
		    timer_loan__()
			timer = time_global()
		end
	end
end

function timer_loan__()
    if not has_alife_info("loaner_first_messege") then
        news_manager.send_tip(db.actor, "Привет, Сталкер. Ты не забывай, что ты мне денег должен. Я жду.", 0, "stalker", 20000)
		db.actor:give_info_portion("loaner_first_messege")
		
	elseif has_alife_info("loaner_first_messege") then
	    db.actor:disable_info_portion("have_loan_money")
	    db.actor:disable_info_portion("loaner_first_messege")
	    db.actor:disable_info_portion("loaner_second_messege")
        db.actor:change_character_reputation(db.actor:character_reputation() - 100)
        news_manager.send_tip(db.actor, "Это я, помнишь меня? Ты у меня деньги занял, так и не вернул ни фига, придурок. Подавись ты этими деньгами!", 0, "stalker", 20000)
    end
end









