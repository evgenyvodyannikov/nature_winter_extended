--/Получили любой из заказов
function give_order_to_actor()
    have_order = false
	waiting_order_complete = false
		--news_manager.send_tip(db.actor, "give_order_to_actor", 0, "trader", 4000)
end

function start_time_waiting_order()
    if not waiting_order_complete then
	    db.actor:set_fastcall(timer_waiting_order, db.actor)
		--news_manager.send_tip(db.actor, "set_fastcallvvv", 0, "trader", 4000)
	end
end

--/Установка рамдомного времени
function random_time_wait_order()
  local random_time = math.random(1,3)
	if random_time == 1 then
	    time_waiting_order = time_waiting_order + time_wait_order_min
		--news_manager.send_tip(db.actor, "time_wait_order_min", 0, "trader", 5000)
	elseif random_time == 2 then
	    time_waiting_order = time_waiting_order + time_wait_order_max
		--news_manager.send_tip(db.actor, "time_wait_order_max", 0, "trader", 5000)
	  else  --/random_time == 3
	    time_waiting_order = time_waiting_order + time_wait_order_norm
		--news_manager.send_tip(db.actor, "5!", 0, "trader", 5000)
	end	
end

--/Ждем заказ	
function timer_waiting_order()
    if not waiting_order_complete and have_order then
        if time_global() - timer > time_waiting_order then
		    news_manager.send_tip(db.actor, Order_Completed, 0, "stalker", 4000)
	 	       waiting_order_complete = true
			time_waiting_order = 0
	    end
	end
end

start_time_waiting_order()























