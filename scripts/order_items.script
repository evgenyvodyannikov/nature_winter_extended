--/Даем задаток --и если НПС не выполнил заказ - забераем задаток
function give_zadadok_on_order(actor, npc)
	local zadatok = 0
	if have_order_pistol then
		zadatok = 700
	elseif have_order_weapon_for_close_combat then
		zadatok = 2000
	elseif have_order_wpn_for_shturm then
		zadatok = 4000
	elseif have_order_wpn_sniper then
		zadatok = 7000
	elseif have_order_outfit then
		zadatok = 8000
	elseif have_order_exo then
		zadatok = 12000
	end
	--if not performer_order_fail then
	dialogs.relocate_money(npc, zadatok, "out")
	    have_order = true
    timer = time_global()
	-- else
	--  dialogs.relocate_money(actor, zadatok, "in")
end

--/Проверка задатка
function have_zadatok_on_order(actor, npc)
 	local zadatok = 0
	if have_order_pistol then
		zadatok = 700
	elseif have_order_weapon_for_close_combat then
		zadatok = 2000
	elseif have_order_wpn_for_shturm then
		zadatok = 4000
	elseif have_order_wpn_sniper then
		zadatok = 7000
	elseif have_order_outfit then
		zadatok = 8000
	elseif have_order_exo then
		zadatok = 12000
	end
    return actor:money() >= zadatok		
end

--/Даем остальную сумму
function give_money_on_order(actor, npc)
	local money = 0
	if have_order_pistol then
		money = 2800
	elseif have_order_weapon_for_close_combat then
		money = 8000
	elseif have_order_wpn_for_shturm then
		money = 16000
	elseif have_order_wpn_sniper then
		money = 18000
	elseif have_order_outfit then
		money = 32000
	elseif have_order_exo then
		money = 48000
	end
	dialogs.relocate_money(npc, money, "out")	   
end

--/Проверка остальной суммы
function have_money_on_order(actor, npc)
 	local money = 0
	if have_order_pistol then
		money = 2800
	elseif have_order_weapon_for_close_combat then
		money = 8000
	elseif have_order_wpn_for_shturm then
		money = 16000
	elseif have_order_wpn_sniper then
		money = 18000
	elseif have_order_outfit then
		money = 32000
	elseif have_order_exo then
		money = 48000
	end
    return actor:money() >= money		
end

--/Если передумали или типа "сброс"
function peredumal_or_not_money_or_reset()
    if have_order_pistol then
	    have_order_pistol = false
		
	elseif have_order_weapon_for_close_combat then
	    have_order_weapon_for_close_combat = false
		
	elseif have_order_wpn_for_shturm then
	    have_order_wpn_for_shturm = false
		
	elseif have_order_wpn_sniper then
	    have_order_wpn_sniper = false
		
	elseif have_order_outfit then
	    have_order_outfit = false
		
	elseif have_order_exo then
	    have_order_exo = false
	end
	time_waiting_order = 0
end

