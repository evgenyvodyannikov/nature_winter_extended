--/Полчаем заказанный итем
function given_order_to_actor(trader, actor)          
    if have_order_pistol and random == 1 then
        dialogs.relocate_item_section(trader, wpn_pistol_1, "in")   
	elseif have_order_pistol and random == 2 then
	    dialogs.relocate_item_section(trader, wpn_pistol_2, "in")   
		
    elseif have_order_weapon_for_close_combat and random == 1 then
        dialogs.relocate_item_section(trader, wpn_shotgun_1, "in")
	elseif have_order_weapon_for_close_combat and random == 2 then
	    dialogs.relocate_item_section(trader, wpn_shotgun_2, "in")
		
    elseif have_order_wpn_for_shturm and random == 1 then
        dialogs.relocate_item_section(trader, wpn_shturm_1, "in")
	elseif have_order_wpn_for_shturm and random == 2 then
	    dialogs.relocate_item_section(trader, wpn_shturm_2, "in")
		
    elseif have_order_wpn_sniper and random == 1 then
        dialogs.relocate_item_section(trader, wpn_sniper_1, "in")
	elseif have_order_wpn_sniper and random == 2 then
	    dialogs.relocate_item_section(trader, wpn_sniper_2, "in")
		
    elseif have_order_outfit and random == 1 then
        dialogs.relocate_item_section(trader, wpn_outfit_1, "in")
	elseif have_order_outfit and random == 2 then
	    dialogs.relocate_item_section(trader, wpn_outfit_2, "in")

	elseif have_order_exo and random == 1 then
        dialogs.relocate_item_section(trader, wpn_exo_1, "in")
	elseif have_order_exo and random == 2 then
	    dialogs.relocate_item_section(trader, wpn_exo_2, "in")
    end  
end

