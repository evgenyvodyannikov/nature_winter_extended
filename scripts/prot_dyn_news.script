 time_news = 0 -- переменная промежутка времени 
   
 function time_update_dyn_news() -- функция промежутка времени 
  local time = time_global() -- переменная времени 
   if time_news < time then 
     time_news = time + 300000 -- время через которое будет вызываться сообщение 300 сек
     prot_dyn_news.update_dyn_news() 
    end 
 end 
   
 function update_dyn_news() 
   news_manager.send_tip(db.actor, (dyn_news[math.random(21)]), nil, nil, 60000)  -- время через которое будет удаляться сообщение 60 сек
 end
