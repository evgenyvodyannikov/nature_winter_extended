function has_rare_items_01(actor, npc)
	return actor:money() >= 14000
end

function rare_items_01(actor, npc)
dialogs.relocate_money(npc, 14000, "out")
dialogs.relocate_item_section(actor, "wpn_glock_1a", "in")
end

