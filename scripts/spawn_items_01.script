bm_anom_create()
end

function knife_create()
local x= -213,283
local y= -22,544
local z= -126,852
local level_vertex= 41279
local game_vertex_id= 59
alife():create("wpn_knife",vector():set(x,y,z),level_vertex,game_vertex_id)
end

