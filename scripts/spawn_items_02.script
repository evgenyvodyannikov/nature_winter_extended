end

function ak76_modifier_l_create()
local x= -194,638
local y= -19,494
local z= -133,087
local level_vertex= 63641
local game_vertex_id= 56
alife():create("wpn_ak76_modifier_l",vector():set(x,y,z),level_vertex,game_vertex_id)
end

