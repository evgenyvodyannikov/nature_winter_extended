function actor_give_money_gauss(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "wpn_dark_gauss", "out")
	dialogs.relocate_money(second_speaker, 25000, "in")
end

function actor_have_dark_gauss(actor, npc)
      return actor:object("wpn_dark_gauss") ~= nil
end

function actor_give_money_gauss_30000(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "wpn_dark_gauss", "out")
	dialogs.relocate_money(second_speaker, 30000, "in")
end

