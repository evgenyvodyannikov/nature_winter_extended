function spawn_raw_meat()
local x= -246,332
local y= -24,792
local z= -133,626
local level_vertex= 11715
local game_vertex_id= 4
alife():create("raw_meat",vector():set(x,y,z),level_vertex,game_vertex_id)
end

function actor_have_raw_meat(actor, npc)
      return actor:object("raw_meat") ~= nil
end

function actor_have_raw_meat_done(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "raw_meat", "out")
	dialogs.relocate_item_section(second_speaker, "ammo_gauss", "in")
end

function kill_npc_883(actor, npc)
	npc:kill(npc) 
end

