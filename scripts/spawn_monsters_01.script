function create()
db.actor:give_info_portion("call_funct_begin")
    level.add_pp_effector("alcohol.ppe", 1973, false)
local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_case_1del4]])
snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end

