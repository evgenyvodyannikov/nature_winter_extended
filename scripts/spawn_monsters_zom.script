end

function spawn_zombie1_one()
local x= -7,644
local y= 4,188
local z= 7,992
local level_vertex= 1851
local game_vertex_id= 1125
alife():create("zombie_first_zom_one",vector():set(x,y,z),level_vertex,game_vertex_id)
end

