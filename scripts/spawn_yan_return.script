function start_add_spawn()
wpn_create()
outfit_create()
spawn_npc_zombie()
spawn_npc_zombie_two()
end

function wpn_create()
local x= 180,096
local y= -7,826
local z= -100,173
local level_vertex= 134368
local game_vertex_id= 1451
alife():create("wpn_kriss_super_v",vector():set(x,y,z),level_vertex,game_vertex_id)
end

