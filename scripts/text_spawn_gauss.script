function text2_gauss(first_speaker, second_speaker)
text2_gauss_one()
text2_gauss_two()
end

function text2_gauss_one(first_speaker, second_speaker)
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_found_thing")
               local error_text = "%c[255,160,160,160]"..game.translate_string("Сообщение:").."\\n".."%c[default]"..""..game.translate_string("%c[255,255,1,1]Отлично! У него есть гаусс-пушка группировки Грех!%c[default]")..""
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 30000)
end

function text2_gauss_two(first_speaker, second_speaker)
               local task_texture, task_rect = get_texture_info("ui_iconsTotal_found_money")
               local error_text = "%c[255,160,160,160]"..game.translate_string("Сообщение:").."\\n".."%c[default]"..""..game.translate_string("%c[255,255,1,1]Поищи в этом лагере коллекционера. Он заплатит за это оружие намного больше, чем остальные торговцы.%c[default]")..""
               db.actor:give_game_news(error_text, task_texture, task_rect, 0, 30000)
end

