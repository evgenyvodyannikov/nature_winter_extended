---==================================================================================================---
---================================(Модернизация у Сахарова)=========================================---
---==================================================================================================---
function saharov_actor_have_money_to_science_work(actor, npc)
	return actor:money() >= 30000
end
function saharov_actor_give_money_to_science_work(actor, npc)
	dialogs.relocate_money(npc, 30000, "out")	
end
function saharov_actor_dont_money_to_science_work(actor, npc)
	return actor:money() < 30000
end
function saharov_actor_dont_money_to_one_experiment(actor, npc)
	return actor:money() < 20000
end
function saharov_actor_dont_money_to_two_experiment(actor, npc)
	return actor:money() < 35000
end
function saharov_actor_dont_money_to_three_experiment(actor, npc)
	return actor:money() < 50000
end
function saharov_actor_mod_have_money_to_one_experiment(actor, npc)
	return actor:money() >= 20000
end
function saharov_actor_mod_give_money_to_one_experiment(actor, npc)
	dialogs.relocate_money(npc, math.random(10000,20000), "out")	
end
function saharov_actor_mod_have_money_to_two_experiment(actor, npc)
	return actor:money() >= 35000
end
function saharov_actor_mod_give_money_to_two_experiment(actor, npc)
	dialogs.relocate_money(npc, math.random(25000,35000), "out")	
end
function saharov_actor_mod_have_money_to_three_experiment(actor, npc)
	return actor:money() >= 50000
end
function saharov_actor_mod_give_money_to_three_experiment(actor, npc)
	dialogs.relocate_money(npc, math.random(40000,50000), "out")	
end
function actor_have_af_medusa(first_speaker, second_speaker)
      return first_speaker:object("af_medusa") ~= nil
end
function actor_give_af_medusa(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "af_medusa", "out")
end
